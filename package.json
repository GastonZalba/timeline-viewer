{
  "name": "timeline-viewer",
  "version": "1.3.0",
  "description": "A frontend timeline card viewer for news articles with expandable details",
  "type": "module",
  "main": "dist/TimelineViewer.js",
  "module": "dist/TimelineViewer.js",
  "types": "dist/TimelineViewer.d.ts",
  "files": [
    "src/",
    "dist/"
  ],
  "scripts": {
    "start": "node example/server.js",
    "format": "prettier --write \"src/**/*.{ts,scss}\" \"example/**/*.{js,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,scss}\" \"example/**/*.{js,html,css}\"",
    "build:css": "sass src/styles.scss dist/styles.css",
    "build:ts": "tsc",
    "build": "npm run format && npm run build:ts && npm run build:css",
    "dev": "concurrently --kill-others \"npm run build:ts -- --watch\" \"npm run build:css -- --watch\" \"nodemon example/server.js\""
  },
  "keywords": [
    "timeline",
    "cards",
    "news",
    "viewer",
    "ui-component"
  ],
  "author": "Gastón Zalba",
  "license": "MIT",
  "peerDependencies": {
    "lightgallery": "^2.9.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "sass": "~1.99.0",
    "typescript": "^6.0.3"
  }
}
