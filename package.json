{
  "name": "timeline-viewer",
  "version": "2.1.10",
  "description": "A frontend timeline card viewer for news articles with expandable details",
  "type": "module",
  "main": "dist/TimelineViewer.js",
  "module": "dist/TimelineViewer.js",
  "types": "dist/TimelineViewer.d.ts",
  "files": [
    "src/",
    "dist/"
  ],
  "scripts": {
    "start": "node example/server.js",
    "format": "prettier --write \"src/**/*.{ts,scss}\" \"example/**/*.{js,html,css}\" \"test/**/*.js\" \"e2e/**/*.js\" \"playwright.config.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,scss}\" \"example/**/*.{js,html,css}\" \"test/**/*.js\" \"e2e/**/*.js\" \"playwright.config.js\"",
    "build:css": "sass src/styles.scss dist/styles.css",
    "build:ts": "tsc",
    "build": "npm run format && npm run build:ts && npm run build:css",
    "watch": "concurrently --kill-others \"npm run build:ts -- --watch\" \"npm run build:css -- --watch\" \"nodemon example/server.js\"",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run build:ts && node --test test/",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "timeline",
    "cards",
    "news",
    "viewer",
    "ui-component"
  ],
  "author": "Gastón Zalba",
  "license": "MIT",
  "peerDependencies": {
    "lightgallery": "^2.9.0",
    "ol": "^10.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.3",
    "jsdom": "^22.1.0",
    "nodemon": "^3.1.14",
    "ol": "^10.10.0",
    "prettier": "^3.9.6",
    "sass": "~1.99.0",
    "typescript": "^6.0.3"
  }
}
